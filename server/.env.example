# ==========================================
# SkillBridge Server Environment Template
# ==========================================

PORT=5000

# Set to 'production' on Render; 'development' for local
NODE_ENV=production

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/skillbridge)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillbridge?retryWrites=true&w=majority

# Strong random keys for JWT signing
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Cookie SameSite policy:
# - 'none' on Render (REQUIRED for cross-domain cookies when frontend is on Vercel/Netlify)
# - 'lax' for local development on the same host
COOKIE_SAMESITE=none

# Allowed frontend origin (no trailing slash)
# Example: https://skillbridge.vercel.app or http://localhost:5173
CLIENT_URL=http://localhost:5173
